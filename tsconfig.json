{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "problems",
    "outDir": "dist",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["problems/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
